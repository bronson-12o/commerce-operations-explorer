{
  "name": "Commerce Operations Explorer",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "expressions": [
      {
        "name": "SourceFolder",
        "kind": "m",
        "expression": "\"C:\\Users\\Bronson\\Documents\\CommerceExplorer\\data\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_key",
            "dataType": "string",
            "sourceColumn": "customer_key",
            "summarizeBy": "none"
          },
          {
            "name": "geography_key",
            "dataType": "string",
            "sourceColumn": "geography_key",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "purchased_at",
            "dataType": "dateTime",
            "sourceColumn": "purchased_at",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "purchase_date",
            "dataType": "dateTime",
            "sourceColumn": "purchase_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "delivery_date",
            "dataType": "dateTime",
            "sourceColumn": "delivery_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "estimated_date",
            "dataType": "dateTime",
            "sourceColumn": "estimated_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "delivered_at",
            "dataType": "dateTime",
            "sourceColumn": "delivered_at",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "estimated_at",
            "dataType": "dateTime",
            "sourceColumn": "estimated_at",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "item_count",
            "dataType": "int64",
            "sourceColumn": "item_count",
            "summarizeBy": "none"
          },
          {
            "name": "merchandise_value",
            "dataType": "decimal",
            "sourceColumn": "merchandise_value",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "freight_value",
            "dataType": "decimal",
            "sourceColumn": "freight_value",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "payment_value",
            "dataType": "decimal",
            "sourceColumn": "payment_value",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "late",
            "dataType": "boolean",
            "sourceColumn": "late",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_days",
            "dataType": "decimal",
            "sourceColumn": "delivery_days",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "review_score",
            "dataType": "int64",
            "sourceColumn": "review_score",
            "summarizeBy": "none"
          },
          {
            "name": "review_count",
            "dataType": "int64",
            "sourceColumn": "review_count",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"\\fact_order.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Missing = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"purchased_at\", \"purchase_date\", \"delivery_date\", \"estimated_date\", \"delivered_at\", \"estimated_at\", \"item_count\", \"merchandise_value\", \"freight_value\", \"payment_value\", \"late\", \"delivery_days\", \"review_score\", \"review_count\"}),",
                "    Typed = Table.TransformColumnTypes(Missing, {{\"order_id\", type text}, {\"customer_key\", type text}, {\"geography_key\", type text}, {\"status\", type text}, {\"purchased_at\", type datetime}, {\"purchase_date\", type date}, {\"delivery_date\", type date}, {\"estimated_date\", type date}, {\"delivered_at\", type datetime}, {\"estimated_at\", type datetime}, {\"item_count\", Int64.Type}, {\"merchandise_value\", Currency.Type}, {\"freight_value\", Currency.Type}, {\"payment_value\", Currency.Type}, {\"late\", type logical}, {\"delivery_days\", Currency.Type}, {\"review_score\", Int64.Type}, {\"review_count\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Order Count",
            "expression": "COUNTROWS(Orders)",
            "formatString": "#,0"
          },
          {
            "name": "Delivered Orders",
            "expression": "CALCULATE(COUNTROWS(Orders), Orders[status] = \"delivered\")",
            "formatString": "#,0"
          },
          {
            "name": "Delivered Merchandise Value",
            "expression": "CALCULATE(SUM(Orders[merchandise_value]), Orders[status] = \"delivered\")",
            "formatString": "\"R$\" #,0.00"
          },
          {
            "name": "Delivered Freight Value",
            "expression": "CALCULATE(SUM(Orders[freight_value]), Orders[status] = \"delivered\")",
            "formatString": "\"R$\" #,0.00"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Delivered Merchandise Value], [Delivered Orders])",
            "formatString": "\"R$\" #,0.00"
          },
          {
            "name": "Eligible Deliveries",
            "expression": "COUNTROWS(FILTER(Orders, NOT ISBLANK(Orders[late])))",
            "formatString": "#,0"
          },
          {
            "name": "Late Orders",
            "expression": "COUNTROWS(FILTER(Orders, Orders[late] == TRUE()))",
            "formatString": "#,0"
          },
          {
            "name": "On Time Rate",
            "expression": "DIVIDE([Eligible Deliveries] - [Late Orders], [Eligible Deliveries])",
            "formatString": "0.0%"
          },
          {
            "name": "Average Delivery Days",
            "expression": "AVERAGE(Orders[delivery_days])",
            "formatString": "0.0"
          },
          {
            "name": "Latest Review Score",
            "expression": "AVERAGE(Orders[review_score])",
            "formatString": "0.00"
          },
          {
            "name": "Reviewed Orders",
            "expression": "COUNT(Orders[review_score])",
            "formatString": "#,0"
          },
          {
            "name": "Category Merchandise Value",
            "expression": "CALCULATE(SUM(OrderItems[price]), OrderItems[status] = \"delivered\")",
            "formatString": "\"R$\" #,0.00"
          },
          {
            "name": "Dataset Period",
            "expression": "\"Historical Olist commerce records | 2016\u20132018 | BRL\""
          },
          {
            "name": "Metric Definition",
            "expression": "\"Merchandise value excludes freight. Delivered orders only. Not platform revenue or profit.\""
          },
          {
            "name": "Delivery Definition",
            "expression": "\"Late = delivered calendar date after estimated calendar date. Missing dates are excluded.\""
          },
          {
            "name": "Review Definition",
            "expression": "\"Latest answered review per order; creation timestamp and source row break ties. Descriptive, not causal.\""
          },
          {
            "name": "Source Attribution",
            "expression": "\"Data: Olist on Kaggle | CC BY-NC-SA 4.0 | Independent project by Bronson Hatch\""
          }
        ]
      },
      {
