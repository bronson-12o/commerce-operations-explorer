              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"\\fact_order_item.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Missing = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"item_sequence\", \"shipping_limit_at\", \"price\", \"freight\", \"purchase_date\"}),",
                "    Typed = Table.TransformColumnTypes(Missing, {{\"order_id\", type text}, {\"item_sequence\", Int64.Type}, {\"product_id\", type text}, {\"seller_id\", type text}, {\"shipping_limit_at\", type datetime}, {\"price\", Currency.Type}, {\"freight\", Currency.Type}, {\"customer_key\", type text}, {\"geography_key\", type text}, {\"purchase_date\", type date}, {\"status\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
